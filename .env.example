# Copy this file to .env and fill in the values for this site, then run ./deploy.sh
#
# Postgres is NOT part of this stack — it must already be running on this host
# (outside Docker) or reachable elsewhere on the network. Create the
# palmaccounts_global database and a role for the API before first deploy.

# --- Postgres (managed outside this stack) ---
# host.docker.internal reaches Postgres on the same machine, outside Docker.
# Point this at a different host/IP if Postgres lives elsewhere on the LAN.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=palmaccounts_global
DB_USER=postgres
DB_PASSWORD=changeme

# --- API secrets ---
# Generate a real random secret for production, e.g.: openssl rand -base64 48
JWT_KEY=changeme-generate-a-long-random-secret
JWT_ISSUER=PalmAccounts

# --- Networking ---
# The LAN IP or hostname other machines on site use to reach this box.
LAN_HOST=192.168.1.100

# --- Ports (change only if they collide with something else on this host) ---
API_PORT=5000
POS_PORT=3002
ERP_PORT=3003
PLATFORM_PORT=3004
PALM_CAFE_PORT=3005

# --- Image tags ---
# v1-prod always tracks the latest palm-prod-v1 build. Pin to a specific
# release_version tag (see the deploy-palm-prod-v1 GitHub Actions run) to hold
# a site back from an update.
API_TAG=v1-prod
ERP_TAG=v1-prod
POS_TAG=v1-prod
PLATFORM_TAG=v1-prod
PALM_CAFE_TAG=v1-prod
